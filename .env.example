# ==============================================================================
# AI Assistive Tutor for Visually Impaired Students
# Environment Configuration Template
# ==============================================================================

# --- BACKEND (Python FastAPI) ---
# Copy to backend/.env

# Google Gemini API Key (Required for AI Tutor contextual explanations)
# Generate from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated, no trailing slashes)
# Add your deployed frontend URL here (e.g. Vercel, Netlify, Cloudflare Pages)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173

# Server Bind Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Path to custom tesseract executable (if not on standard PATH)
# TESSERACT_CMD=/usr/local/bin/tesseract

# --- FRONTEND (React 18 / Vite) ---
# Copy to frontend/.env (or set in deployment hosting provider)

# Base URL pointing to the FastAPI backend service
# In local development: http://localhost:8000
# In production: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:8000
