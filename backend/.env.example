# AI Assistive Tutor - Backend Environment Variables
# Copy to backend/.env and fill in your values

# Google Gemini API Key for Educational Tutor Explanations
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins for production frontend (comma-separated, no trailing slash)
# Example: https://ai-assistive-tutor.pages.dev,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173

# Server host & port
HOST=0.0.0.0
PORT=8000
