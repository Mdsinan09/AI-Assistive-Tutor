# AI Assistive Tutor - Frontend Environment Variables
# Copy to frontend/.env for production or custom environment

# URL to backend API service (Leave blank or unset during local dev to use Vite proxy)
# In production on Cloudflare Pages, set this to your backend domain or Cloudflare Tunnel URL
# e.g., https://api.yourdomain.com or https://your-tunnel.trycloudflare.com
VITE_API_BASE_URL=
